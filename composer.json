{
    "name": "hibira-io/pulse",
    "description": "Laravel Pulse card for Hibira: realtime connections, messages and data sent next to your plan's limits, and the busiest channels right now",
    "keywords": [
        "laravel",
        "laravel-pulse",
        "pulse-card",
        "monitoring",
        "websocket",
        "realtime",
        "broadcasting",
        "pusher",
        "hibira"
    ],
    "homepage": "https://hibira.io",
    "license": "MIT",
    "authors": [
        {
            "name": "Hibira",
            "homepage": "https://hibira.io"
        }
    ],
    "support": {
        "issues": "https://github.com/hibira-io/pulse/issues",
        "docs": "https://github.com/hibira-io/pulse#readme",
        "email": "support@hibira.io"
    },
    "require": {
        "php": "^8.1",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "laravel/pulse": "^1.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Hibira\\Pulse\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hibira\\Pulse\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Hibira\\Pulse\\HibiraPulseServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
